---
import { brief } from "../content/site";
import StudioLabel from "./StudioLabel.astro";
---

<section class="section brief" aria-labelledby="brief-heading">
  <div class="wrap brief__grid">
    <StudioLabel text={brief.label} />
    <h2 class="display" id="brief-heading">{brief.heading}</h2>
    <div class="brief__copy">
      <p class="lede">{brief.body}</p>
      <p class="brief__close">{brief.close}</p>
    </div>
  </div>
</section>

<style>
  .brief {
    border-bottom: 1px solid var(--line);
  }

  .brief__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }

  .brief :global(.studio-label) {
    grid-column: 1 / -1;
  }

  .brief h2 {
    max-width: 14ch;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .brief__copy {
    display: grid;
    gap: 1.1rem;
    padding-bottom: 0.2rem;
  }

  .brief__close {
    font-family: var(--font-display);
    font-size: var(--text-subhead);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  @media (max-width: 800px) {
    .brief__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

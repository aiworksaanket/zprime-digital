---
import { industries } from "../content/site";
import StudioLabel from "./StudioLabel.astro";
---

<section class="section industries" aria-labelledby="industries-heading">
  <div class="wrap">
    <header class="section-head">
      <StudioLabel text={industries.label} />
      <h2 id="industries-heading">{industries.heading}</h2>
    </header>

    <ul class="seats">
      {
        industries.items.map((item, i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, "0")}</span>
            <strong class="display">{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .industries {
    border-top: 1px solid var(--line);
  }

  .seats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .seats li {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 12rem;
    padding: 1.5rem 1.25rem 1.7rem 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .seats li:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .seats .mono {
    color: var(--accent);
    font-size: 0.75rem;
  }

  .seats strong {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .seats span:last-child {
    color: var(--muted);
    font-size: var(--text-small);
  }

  @media (max-width: 860px) {
    .seats {
      grid-template-columns: 1fr 1fr;
    }

    .seats li:nth-child(2n) {
      border-right: 0;
      padding-right: 0;
    }

    .seats li:nth-child(odd) {
      padding-right: 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .seats {
      grid-template-columns: 1fr;
    }

    .seats li,
    .seats li:nth-child(odd),
    .seats li:nth-child(even) {
      border-right: 0;
      padding-right: 0;
    }
  }
</style>

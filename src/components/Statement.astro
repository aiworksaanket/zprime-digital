---
import { statement } from "../content/site";
import StudioLabel from "./StudioLabel.astro";
---

<section class="statement theme-accent" aria-labelledby="statement-heading">
  <div class="wrap">
    <StudioLabel text={statement.label} />
    <p class="statement__quote display" id="statement-heading">{statement.quote}</p>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(4.5rem, 11vw, 8.5rem);
  }

  .statement :global(.studio-label) {
    margin-bottom: 1.4rem;
  }

  .statement__quote {
    max-width: 16ch;
    font-size: clamp(2.2rem, 6.2vw, 4.4rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }
</style>

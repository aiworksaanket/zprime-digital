---
import Brief from "../components/Brief.astro";
import ChannelMarquee from "../components/ChannelMarquee.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Industries from "../components/Industries.astro";
import Nav from "../components/Nav.astro";
import Platforms from "../components/Platforms.astro";
import Process from "../components/Process.astro";
import Services from "../components/Services.astro";
import Statement from "../components/Statement.astro";
import Team from "../components/Team.astro";
import Why from "../components/Why.astro";
import { hero, site } from "../content/site";
import Base from "../layouts/Base.astro";
---

<Base title={`${site.name} — ${site.positioning}`} description={hero.lede}>
  <Nav />
  <main id="main">
    <div class="first-fold">
      <Hero />
      <ChannelMarquee />
    </div>
    <Brief />
    <Services />
    <Statement />
    <Process />
    <Why />
    <Industries />
    <Platforms />
    <Team />
    <Contact />
  </main>
  <Footer />
</Base>

<style>
  @media (min-width: 861px) {
    .first-fold {
      display: flex;
      flex-direction: column;
      min-height: calc(100dvh - var(--nav-h));
    }

    .first-fold :global(.hero) {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
